{
  "name": "finance-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "migrate:up": "node-pg-migrate --ignore-pattern \"schema.sql\" up",
