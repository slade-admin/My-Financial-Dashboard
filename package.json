{
  "name": "finance-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "migrate:up": "tsx scripts/migrate.ts up",
    "migrate:down": "tsx scripts/migrate.ts down",
    "backup:key": "tsx scripts/backup.ts keygen",
    "backup": "tsx scripts/backup.ts create",
    "backup:check": "tsx scripts/backup.ts check",
    "backup:restore": "tsx scripts/backup.ts restore",
    "backup:schedule": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/schedule-backup.ps1",
    "account:recover": "tsx scripts/recover-account.ts",
    "test:persistence": "tsx --test scripts/test-persistence.ts",
    "test:ingest-token": "tsx --test scripts/test-ingest-token.ts",
    "lint": "eslint",
    "test:dates": "tsx --test scripts/test-dates.ts",
    "test:sms": "tsx scripts/test-sms.ts",
    "test:imports": "tsx --test scripts/test-imports.ts",
    "test:workflows": "tsx --test scripts/test-workflows.ts",
    "test:inputs": "tsx --test scripts/test-inputs.ts",
    "test:protection": "tsx --test scripts/test-protection.ts",
    "test:recovery": "tsx --test scripts/test-recovery.ts",
    "test:safety": "tsx --test --test-name-pattern=\"database URL guard\" scripts/test-database.ts",
    "test:database": "tsx --test --test-concurrency=1 scripts/test-database.ts scripts/test-persistence.ts scripts/test-financial-ledger.ts scripts/test-imports.ts scripts/test-workflows.ts scripts/test-protection.ts scripts/test-dates.ts scripts/test-ingest-token.ts",
    "test:startup": "tsx --test scripts/test-startup.ts",
    "test:ui": "tsx --test scripts/test-ui.ts",
    "verify": "npm run test:inputs && npm run test:database && npm run test:sms && npm run lint && npm run build && npm run typecheck && npm run test:startup",
    "verify:pilot": "npm run verify && npm run test:ui && npm run test:recovery"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "csv-parse": "^7.0.3",
    "next": "16.4.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "node-pg-migrate": "^9.0.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
