    "test:persistence": "tsx scripts/test-persistence.ts",
    "test:ingest-token": "tsx scripts/test-ingest-token.ts",
    "lint": "eslint",
    "test:dates": "tsx scripts/test-dates.ts",
    "test:sms": "tsx scripts/test-sms.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "next": "16.4.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "node-pg-migrate": "^9.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
